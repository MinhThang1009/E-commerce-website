# Dependencies
node_modules/
.pnpm-store/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build outputs
dist/
build/
out/
.output/

# Test coverage reports — generated bởi jest --coverage / vitest run --coverage
coverage/
backend/coverage/
frontend/coverage/

# DB backups (Phase 40+ pre-migration mysqldump) — không commit
backups/
*.sql.bak

# Logs — dùng absolute path trong logger.js để tránh ghi ra root
*.log
logs/
backend/logs/
!backend/logs/.gitkeep

# Runtime-generated data (vector store, rebuild via npm run ai:rebuild-vectors)
backend/data/vector-db.json
backend/data/vector-db.json.bak

# Upload files — không commit binary files vào git
backend/uploads/*
!backend/uploads/.gitkeep
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS specific
.DS_Store
Thumbs.db

# IDEs
.idea/
.vscode/

