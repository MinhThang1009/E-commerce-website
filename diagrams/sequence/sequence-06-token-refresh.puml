@startuml sequence-06-token-refresh
autoactivate on
' Sơ đồ sequence — Làm mới Access Token (§3.6)
' Ground-truth: auth-service.js:214-243, auth-controller.js:119-129
' auth/routes.js:91, auth/module.js:53-71, middlewares/authenticate.js

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam dpi 150
skinparam sequenceArrowThickness 2
skinparam sequenceGroupBorderThickness 1.5
skinparam sequenceGroupBorderColor #999999
skinparam sequenceParticipant {
  BorderColor #6C8EBF
  BackgroundColor #DAE8FC
}
skinparam sequenceActor {
  BackgroundColor #f5f5f5
  BorderColor #6C8EBF
}
skinparam noteBorderColor #6C8EBF
skinparam noteBackgroundColor #fffde7
skinparam responseMessageBelowArrow true
skinparam defaultFontSize 13
skinparam noteFontSize 12
skinparam sequenceParticipantFontSize 13

actor "Người dùng" as User
participant "Frontend (React)" as FE
participant "Backend API" as API
participant "MySQL DB" as DB

== Phát hiện Access Token hết hạn ==

User ->> FE : Thực hiện thao tác bất kỳ
FE ->> API : Gọi API bảo vệ  [Authorization: Bearer <accessToken>]
note right of API
  authenticate middleware:
  jwt.verify(token, JWT_SECRET, {algorithms:['HS256']})
  → TokenExpiredError
end note
API -->> FE : 401  auth token hết hạn

== Làm mới token (silent refresh) ==

note over FE
  FE intercept 401
  → tự động gọi refresh trước khi báo lỗi người dùng
end note

FE ->> API : POST /api/auth/refresh-token
note right of API
  Không có middleware nào
  (không authenticate, không validateRequest)
  refreshToken đọc từ cookie httpOnly
  hoặc fallback req.body.refreshToken
end note

alt Không có refresh token
  API -->> FE : 401  auth.refreshTokenRequired
else Refresh token không hợp lệ hoặc hết hạn
  note right of API
    jwt.verify(token, JWT_REFRESH_SECRET,
    {algorithms:['HS256']})
    → JsonWebTokenError / TokenExpiredError
  end note
  API -->> FE : 401  auth.refreshTokenInvalid
  FE -->> User : Chuyển về trang đăng nhập
else Refresh token hợp lệ
  API ->> DB : SELECT users WHERE id = decoded.id
  DB -->> API : user row
  alt User không tồn tại
    API -->> FE : 401  auth.refreshTokenError
    FE -->> User : Chuyển về trang đăng nhập
  else Tài khoản bị vô hiệu hóa
    API -->> FE : 401  auth.accountDisabled
    FE -->> User : Chuyển về trang đăng nhập
  else Hợp lệ — cấp token mới
    note right of API
      signAccessToken({id, role}, JWT_SECRET, JWT_EXPIRES_IN)
      signRefreshToken({id}, JWT_REFRESH_SECRET, JWT_REFRESH_EXPIRES_IN)
      Token rotation: refresh token cũ bị thay thế
    end note
    API -->> FE : 200  { token: newAccessToken }
    note right of API
      Set-Cookie: refreshToken=<newRefreshToken>
      httpOnly=true  sameSite=strict
      path=/api/auth  maxAge=JWT_REFRESH_EXPIRES_IN
    end note
  end
end

== Retry request ban đầu ==

FE ->> API : Retry gọi API ban đầu  [Authorization: Bearer <newAccessToken>]
API -->> FE : 200  Kết quả bình thường
FE -->> User : Hiển thị kết quả

@enduml
