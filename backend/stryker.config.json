{
  "testRunner": "jest",
  "jest": {
    "projectType": "custom",
    "configFile": "jest.config.js",
    "enableFindRelatedTests": true
  },
  "mutate": [
    "src/modules/payment/services/payment-service.js",
    "src/modules/orders/services/orders-service.js"
  ],
  "timeoutMS": 15000,
  "timeoutFactor": 1.5,
  "concurrency": 4,
  "reporters": ["clear-text", "progress"],
  "coverageAnalysis": "perTest",
  "ignorePatterns": ["node_modules", "coverage", "reports"],
  "mutator": {
    "excludedMutations": ["StringLiteral", "ObjectLiteral", "ArrayDeclaration"]
  }
}
