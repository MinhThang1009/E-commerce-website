flowchart TD
    PREV([⟶ Từ bước Tải lịch sử hội thoại])
    R["⑤ Truy xuất sản phẩm (Retrieval)"]
    R_DEC{"Có kết quả?"}
    RFB["Dự phòng (Low Confidence Fallback)"]
    G["⑥ Tăng cường & Sinh câu trả lời (Augmentation & Generation)"]
    G_DEC{"LLM thành công?"}
    GFB["Từ khóa dự phòng (Keyword Fallback)"]
