{
  "name": "techstore-backend",
  "version": "1.0.0",
  "main": "src/server.js",
  "_moduleAliases": {
    "@modules": "src/modules",
    "@shared": "src/shared",
    "@utils": "src/utils",
    "@middlewares": "src/middlewares",
    "@models": "src/models",
    "@config": "src/config",
    "@services": "src/services",
    "@jobs": "src/jobs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "predev": "cmd /c \"for /f tokens^=5 %a in ('netstat -ano ^| findstr :8888 ^| findstr LISTENING') do taskkill /F /T /PID %a\" & exit 0",
    "dev": "node --watch --watch-path=src src/server.js",
    "kill": "cmd /c \"for /f tokens^=5 %a in ('netstat -ano ^| findstr :8888 ^| findstr LISTENING') do taskkill /F /T /PID %a\"",
    "test": "jest --runInBand --coverage --coverageReporters=text --coverageReporters=json-summary --forceExit",
    "test:watch": "jest --watch",
    "test:fast": "jest --forceExit --no-coverage",
    "test:file": "jest --forceExit --no-coverage --testPathPattern",
    "test:cov": "jest --forceExit --coverage --testPathPattern",
    "test:changed": "jest --forceExit --no-coverage --onlyChanged",
    "test:related": "jest --forceExit --no-coverage --findRelatedTests",
    "test:coverage:changed": "jest --forceExit --changedSince=main --coverage --coverageReporters=text",
    "check:routes": "node scripts/check-unused-routes.mjs",
    "check:patch-coverage": "node scripts/check-patch-coverage.mjs",
    "check:unused": "knip --no-exit-code",
    "test:mutation": "stryker run",
    "test:ci": "jest --ci --runInBand --forceExit --coverage",
    "test:integration": "jest --config jest.integration.config.js --runInBand --forceExit",
    "test:api": "jest --config jest.api.config.js --runInBand --forceExit",
    "db:test:setup": "node scripts/rebuild-test-db.js",
    "db:sync-test": "node scripts/sync-test-db.js",
    "db:cleanup-test-data": "node scripts/db-cleanup-test-data.js",
    "test:e2e": "jest --config jest.e2e.config.js --runInBand --forceExit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:strict": "eslint . --max-warnings 0",
    "db:check": "node -e \"require('./src/models'); console.log('Models OK')\"",
    "db:migrate": "node -r module-alias/register -e \"require('dotenv').config()\" node_modules/sequelize-cli/lib/sequelize db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed:all": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "db:cleanup": "node scripts/db-cleanup.js",
    "db:seed": "node scripts/rebuild-db.js && npx sequelize-cli db:seed:all",
    "docs:openapi": "node -e \"require('dotenv').config();const s=require('./src/config/swagger');require('fs').writeFileSync('./docs/openapi.json',JSON.stringify(s,null,2));console.log('Exported',Object.keys(s.paths||{}).length,'paths')\"",
    "i18n:translate": "node scripts/translate-content.js",
    "i18n:dry-run": "node scripts/translate-content.js --dry-run",
    "db:fresh": "node scripts/rebuild-db.js",
    "db:reset": "node scripts/rebuild-db.js",
    "db:verify": "node scripts/db-verify.js",
    "db:index": "node scripts/index-products.js",
    "ai:rebuild-vectors": "node scripts/index-products.js",
    "db:import": "node scripts/import-products.js",
    "db:sync": "node scripts/sync-products.js",
    "db:sync:dry": "node scripts/sync-products.js --dry-run",
    "db:export": "node scripts/export-seed.js",
    "db:export-seed": "node scripts/export-seed.js",
    "db:export:json": "node scripts/export-products-json.js",
    "check-docs": "node -r dotenv/config scripts/check-docs.js"
  },
  "keywords": [
    "ecommerce",
    "api",
    "nodejs",
    "express",
    "sequelize"
  ],
  "author": "",
  "license": "ISC",
  "description": "Backend API for E-commerce website",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "^2.3.4",
    "moment": "^2.30.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "mysql2": "^3.19.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.3",
    "sanitize-html": "^2.17.4",
    "sequelize": "^6.37.7",
    "sharp": "^0.34.3",
    "slugify": "^1.6.6",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "axios": "^1.13.6",
    "eslint": "^9.28.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "jest": "^29.7.0",
    "knip": "^6.15.0",
    "lint-staged": "^17.0.4",
    "nodemon": "^3.1.10",
    "prettier": "^3.5.3",
    "sequelize-cli": "^6.6.3",
    "supertest": "^7.1.1"
  }
}
