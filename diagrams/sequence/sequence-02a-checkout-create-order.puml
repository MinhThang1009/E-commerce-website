@startuml sequence-02a-checkout-create-order
' Sơ đồ sequence — Checkout (2a): Tạo đơn hàng (§3.2a)
' Ground-truth: orders-service.js:65-434, orders/routes.js, orders-controller.js

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam dpi 150
skinparam sequenceArrowThickness 2
skinparam sequenceGroupBorderThickness 1.5
skinparam sequenceGroupBorderColor #999999
skinparam sequenceParticipant {
  BorderColor #6C8EBF
  BackgroundColor #DAE8FC
}
skinparam sequenceActor {
  BackgroundColor #f5f5f5
  BorderColor #6C8EBF
}
skinparam noteBorderColor #6C8EBF
skinparam noteBackgroundColor #fffde7
skinparam responseMessageBelowArrow true
skinparam defaultFontSize 13
skinparam noteFontSize 12
skinparam sequenceParticipantFontSize 13

actor "Người dùng" as User
participant "Frontend (React)" as FE
participant "Backend API" as API
participant "MySQL DB" as DB

== Tạo đơn hàng ==

User ->> FE : Điền địa chỉ + chọn phương thức thanh toán
FE ->> API : POST /api/orders  [authenticate → validateRequest]
note right of API: sessionId cookie → gộp giỏ khách nếu có

note right of API: BEGIN TRANSACTION

API ->> DB : Hủy đơn pending cũ + hoàn kho
note right of API: cancelPendingOrdersByUser

loop Mỗi sản phẩm trong giỏ hàng
  API ->> DB : SELECT FOR UPDATE  variant / product
  DB -->> API : stock row (locked)
  alt Ngừng bán hoặc không đủ hàng
    API -->> FE : 400  productInactive / stockInsufficient
  end
  API ->> DB : Trừ tồn kho + ghi inventory_log
end

opt Có mã giảm giá
  API ->> DB : SELECT FOR UPDATE  discount_code
  DB -->> API : mã (locked)
  alt Chưa bắt đầu / hết hạn / không hợp lệ / hết lượt / chưa đủ giá trị tối thiểu
    API -->> FE : 400  couponNotStarted / couponInvalid
    API -->> FE : 400  couponExpired / LimitReached / MinOrderNotMet
  end
  API ->> DB : discount_code.usedCount + 1
  note right of API: Chỉ manual payment (COD / bank_transfer / installment)
end

note right of API: total = subtotal + shippingCost − discount

API ->> DB : INSERT orders  (status='pending', paymentStatus='pending')
API ->> DB : INSERT order_items  (unitPrice, quantity, subtotal)
API ->> DB : INSERT inventory_logs  (changeType='sale')

alt Thanh toán thủ công  (COD / bank_transfer / installment)
  API ->> DB : Xóa giỏ hàng  (carts → converted)
  note right of API
    COMMIT
    email xác nhận + event (async)
  end note
  API -->> FE : 201  { id, number, status:'pending', total }
  FE -->> User : Đặt hàng thành công
else Thanh toán online  (MoMo / VNPay)
  note right of API
    COMMIT
    Giỏ hàng & discount chờ IPN xác nhận
  end note
  API -->> FE : 201  { id, number, status:'pending', total }
  FE -->> User : Chuyển sang bước thanh toán
end

@enduml
