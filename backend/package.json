{
  "name": "techstore-backend",
  "version": "1.0.0",
  "main": "src/server.js",
  "_moduleAliases": {
    "@modules": "src/modules",
    "@shared": "src/shared",
    "@utils": "src/utils",
    "@middlewares": "src/middlewares",
    "@models": "src/models",
    "@config": "src/config",
    "@services": "src/services",
    "@jobs": "src/jobs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch",
    "test:fast": "jest --forceExit --no-coverage",
    "test:file": "jest --forceExit --no-coverage --testPathPattern",
    "test:cov": "jest --forceExit --coverage --testPathPattern",
    "test:ci": "jest --ci --runInBand --forceExit --coverage",
    "test:integration": "jest --config jest.integration.config.js --runInBand --forceExit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:strict": "eslint . --max-warnings 0",
    "db:check": "node -e \"require('./src/models'); console.log('Models OK')\"",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed:all": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "db:cleanup": "node scripts/dbCleanup.js",
    "db:seed": "node scripts/rebuildDb.js",
    "docs:openapi": "node -e \"require('dotenv').config();const s=require('./src/config/swagger');require('fs').writeFileSync('./docs/openapi.json',JSON.stringify(s,null,2));console.log('Exported',Object.keys(s.paths||{}).length,'paths')\"",
    "i18n:translate": "node scripts/translateContent.js",
    "i18n:dry-run": "node scripts/translateContent.js --dry-run",
    "db:fresh": "node scripts/rebuildDb.js",
    "db:reset": "node scripts/rebuildDb.js",
    "db:verify": "node scripts/dbVerify.js",
    "db:index": "node scripts/index-products.js",
    "ai:rebuild-vectors": "node scripts/index-products.js",
    "db:import": "node scripts/importProducts.js",
    "db:sync": "node scripts/syncProducts.js",
    "db:sync:dry": "node scripts/syncProducts.js --dry-run",
    "db:export": "node scripts/exportSeed.js",
    "db:export-seed": "node scripts/exportSeed.js",
    "db:export:json": "node scripts/exportProductsJson.js"
  },
  "keywords": [
    "ecommerce",
    "api",
    "nodejs",
    "express",
    "sequelize"
  ],
  "author": "",
  "license": "ISC",
  "description": "Backend API for E-commerce website",
  "dependencies": {
    "argon2": "^0.44.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "^2.3.4",
    "moment": "^2.30.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "mysql2": "^3.19.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.3",
    "qs": "^6.15.0",
    "rate-limit-redis": "^4.3.1",
    "redis": "^5.5.6",
    "sanitize-html": "^2.17.4",
    "sequelize": "^6.37.7",
    "sharp": "^0.34.3",
    "slugify": "^1.6.6",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "axios": "^1.13.6",
    "eslint": "^9.28.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "jest": "^29.7.0",
    "lint-staged": "^17.0.4",
    "nodemon": "^3.1.10",
    "prettier": "^3.5.3",
    "sequelize-cli": "^6.6.3",
    "supertest": "^7.1.1"
  },
  "lint-staged": {
    "src/**/*.js": [
      "eslint --max-warnings 0",
      "prettier --write"
    ]
  }
}
