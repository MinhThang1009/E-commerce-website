@startuml modular_architecture
left to right direction
skinparam componentStyle uml2
skinparam dpi 150
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontSize 11
skinparam defaultFontName Arial

skinparam component {
  BackgroundColor #DAE8FC
  BorderColor #6C8EBF
  FontColor #000000
}
skinparam package {
  BackgroundColor #eff6ff
  BorderColor #6C8EBF
  FontColor #000000
}
skinparam ArrowColor #4D4D4D
skinparam noteBackgroundColor #fffde7
skinparam noteBorderColor #6C8EBF

' === Cột trái: Storefront (trên) + Engagement (dưới) ===
package "Storefront (Full DI)" as GS {
  [auth]
  [users]
  [catalog]
  [cart]
}

package "Engagement (Full DI)" as GE {
  [ai]
  [reviews]
  [wishlist]
  [content]
  [upload]
}

' === Cột phải: Commerce (trên) + Shared Infra (dưới) ===
package "Commerce (Full DI)" as GC {
  [orders]
  [payment]
  [inventory]
}

package "Shared Infrastructure" as Infra {
  component "EventBus\n(pub/sub · Promise.allSettled)" as EB
  component "UnitOfWork\n(runInTransaction · SELECT FOR UPDATE)" as UoW
  () "emailService" as Email
  () "vectorStoreService" as VStore
}

' === Dưới: Singleton ===
package "5 Singleton / Thin Wrapper" as Singleton {
  [admin]
  [attribute]
  [image]
  [search-history]
  [discount-code]
}

' === Layout: 2 cột + 1 hàng dưới ===
GS -[hidden]down-> GE
GC -[hidden]down-> Infra
GS -[hidden]right-> GC
GE -[hidden]right-> Infra
GE -[hidden]down-> Singleton
Infra -[hidden]down-> Singleton

' === EventBus (async, dashed) ===
[orders] ..> EB : publish order.cancelled
EB ..> [inventory] : subscribe order.cancelled

' === Service injection (sync, solid) ===
[payment] -right-> [orders] : ordersService
[admin] -up-> [orders] : delegate

' === Cross-module model sharing ===
[cart] -right-> [catalog] : Product/Variant
[ai] -up-> [catalog] : Product/Category

' === Shared services (async, dashed) ===
[orders] ..> Email : gửi email
[payment] ..> Email : gửi email
[ai] ..> VStore : RAG search

@enduml
