# EditorConfig — đồng bộ formatting giữa các IDE/editor
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown: trailing whitespace có ý nghĩa (line break)
[*.md]
trim_trailing_whitespace = false

# Makefile: bắt buộc tab
[Makefile]
indent_style = tab

# Shell scripts
[*.sh]
indent_style = space
indent_size = 2

# Python scripts (nếu có)
[*.py]
indent_size = 4
