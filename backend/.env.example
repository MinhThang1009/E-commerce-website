# Server Configuration
PORT=8888
NODE_ENV=development

# Database Configuration
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=techstore
DB_NAME_TEST=techstore_test
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SSL=false
DB_SYNC=false

# Security (REQUIRED - dùng chuỗi ngẫu nhiên dài ít nhất 32 ký tự)
JWT_SECRET=replace_with_strong_random_secret_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_another_strong_random_secret
REFRESH_TOKEN_SECRET=replace_with_another_strong_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# AI LLM (OpenAI-compatible endpoint — đổi model bất kỳ lúc nào)
LLM_BASE_URL=https://your-llm-provider.com/v1
LLM_API_KEY=your_llm_api_key
LLM_MODEL_1=your-primary-model   # model chính (vd: gpt-5.5)
LLM_MODEL_2=your-fallback-model  # fallback 1 khi model chính lỗi (vd: gpt-5.4)
LLM_MODEL_3=your-fallback-model  # fallback 2 khi model trước lỗi (vd: gpt-5.3-codex), optional

# AI Embedding & Translation
# DeepL: đăng ký tại https://deepl.com/pro-api — 500K chars/tháng miễn phí, chất lượng xuất sắc
DEEPL_API_KEY=your_deepl_api_key
# Jina v3: đăng ký miễn phí tại https://jina.ai — 10M tokens/tháng, MTEB 65.5
JINA_API_KEY=your_jina_api_key
# HuggingFace: fallback khi Jina không khả dụng (multilingual-e5-large-instruct → base)
HF_API_KEY=your_huggingface_api_key
# OpenRouter: dùng cho LLM chatbot (không dùng cho embedding nữa)
OPENROUTER_API_KEY=your_openrouter_api_key
TRANSLATE_MODEL=openai/gpt-oss-20b:free
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Email Configuration (Nodemailer - Gmail App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_FROM_NAME=Your Store Name

FRONTEND_URL=http://localhost:5175
BACKEND_URL=http://localhost:8888
API_URL=http://localhost:8888/api
ASSET_BASE_URL=http://localhost:8888
CDN_BASE_URL=
ADMIN_EMAIL=admin@techstore.vn
CORS_ORIGINS_DEV=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175

# CORS cho Express HTTP — nếu để trống, dev fallback về CORS_ORIGINS_DEV
# Production: set danh sách origin cụ thể, KHÔNG dùng '*'
CORS_ORIGIN=

# VNPay Payment Gateway
VNP_TMN_CODE=your_vnpay_tmn_code
VNP_HASH_SECRET=your_vnpay_hash_secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_API=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNP_RETURN_URL=http://localhost:8888/api/payments/vnpay/return
VNP_IPN_URL=http://localhost:8888/api/payments/vnpay/ipn

# MoMo Payment (Production)
MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_API_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:5175/cart?status=momo-return
MOMO_IPN_URL=http://localhost:8888/api/payments/momo/ipn

# MoMo Payment (Dev/Sandbox — override production keys khi NODE_ENV=development)
DEV_PARTNER_CODE=
DEV_ACCESS_KEY=
DEV_SECRET_KEY=
DEV_MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create


# Email options
EMAIL_SECURE=false

# Logging
LOG_LEVEL=info
