@startuml usecase-06-catalog-browse
' Sơ đồ use case — Duyệt & Tìm kiếm Sản phẩm (Catalog browse §2.2a)
' Ground-truth: backend/src/modules/catalog/routes.js — products router (L283-297)
'   GET  /api/products/               — public
'   GET  /api/products/featured       — public
'   GET  /api/products/new-arrivals   — public
'   GET  /api/products/best-sellers   — public
'   GET  /api/products/deals          — public
'   GET  /api/products/filters        — public
'   GET  /api/products/search         — public
'   GET  /api/products/suggestions    — public
'   GET  /api/products/recently-viewed — authenticate (bắt buộc)
' Denominator: 9 routes → 9 UC (tất cả GET, không có state-mutation)
' Scope: product discovery/listing only. Chi tiết sản phẩm → uc-07.
'        Category/Brand browse → uc-08. Admin CRUD → uc-09.
left to right direction
skinparam dpi 300
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #DAE8FC
  BorderColor #6C8EBF
}
skinparam actorStyle awesome

actor "Khách / Bất kỳ\n(Public)" as pub
actor "Khách hàng\n(Customer)" as customer

rectangle "Duyệt sản phẩm — TechStore" {
  usecase "Xem danh sách\nsản phẩm" as UC_list
  usecase "Xem sản phẩm\nnổi bật" as UC_featured
  usecase "Xem sản phẩm\nmới về" as UC_new
  usecase "Xem sản phẩm\nbán chạy" as UC_best
  usecase "Xem sản phẩm\ngiảm giá" as UC_deals
  usecase "Lấy bộ lọc\nsản phẩm" as UC_filters
  usecase "Tìm kiếm\nsản phẩm" as UC_search
  usecase "Gợi ý\ntìm kiếm" as UC_suggest
  usecase "Xem sản phẩm\nđã xem gần đây" as UC_recent
}

pub -- UC_list
pub -- UC_featured
pub -- UC_new
pub -- UC_best
pub -- UC_deals
pub -- UC_filters
pub -- UC_search
pub -- UC_suggest
customer -- UC_recent

note right of UC_list
  GET /api/products — public.
  Filter: category (slug|id), brand (array),
  search, minPrice, maxPrice, inStock, featured.
  Sort giá: COALESCE(MIN(variant.price), basePrice).
  Pagination: page=0 → offset=0 (Math.max guard).
end note

note right of UC_search
  GET /api/products/search — public.
  LIKE trên name_vi, name_en, description_vi,
  short_description_vi, tags; filter status='active'.
end note

note right of UC_suggest
  GET /api/products/suggestions — public.
  Prefix match trên name_vi.
  Trả { id, name, slug, thumbnail }.
  Tối đa 10 gợi ý.
end note

note right of UC_recent
  GET /api/products/recently-viewed — authenticate (bắt buộc).
  Mặc định 10 sản phẩm gần nhất (override qua ?limit=).
  Chỉ customer đã đăng nhập mới có history.
  (Track async khi xem chi tiết → uc-07)
end note
@enduml
