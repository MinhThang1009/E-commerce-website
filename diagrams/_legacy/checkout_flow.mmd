graph LR
    Cart(["Cart"])
    CK["Checkout\nValidate stock\n(SELECT FOR UPDATE)"]

    subgraph CreateOrder["Create Order (Transaction + UoW)"]
        CREATE["createOrder\nDecrement stock\nInsert order + items\nInsert inventory_logs"]
        MANUAL["Manual: COD / bank_transfer\n/ installment\n-> increment discount usedCount\n-> clear cart in tx"]
        ONLINE["Online: MoMo (HMAC-SHA256)\n/ VNPay (HMAC-SHA512)\n-> KHONG clear cart\n-> KHONG tang usedCount"]
    end

    PAYURL["POST /payments/momo/create-url\n+ /vnpay/create-url\nTao payment URL\nRedirect user"]
    IPN["IPN Callback\nVerify HMAC signature\nUpdate paymentStatus=paid\nIncrement discount usedCount\nClear cart + Send email"]
    DONE["Order Created\nSend email async"]

    subgraph States["Order States"]
        P(["pending"])
        PR(["processing"])
        SH(["shipped"])
        D(["delivered"])
        X(["cancelled\nrestore stock"])
    end

    Cart --> CK --> CREATE
    CREATE --> MANUAL --> DONE
    CREATE --> ONLINE --> DONE
    ONLINE -.->|"sau createOrder"| PAYURL
    PAYURL -.->|"server-to-server"| IPN
    DONE --> P --> PR --> SH --> D
    PR -->|"user xac nhan"| D
    P -.->|cancel| X
    PR -.->|cancel| X
    SH -.->|admin cancel| X

    style Cart fill:#42A5F5,color:#fff
    style CK fill:#66BB6A,color:#fff
    style CREATE fill:#AB47BC,color:#fff
    style MANUAL fill:#FFB74D
    style ONLINE fill:#D81B60,color:#fff
    style PAYURL fill:#1565C0,color:#fff
    style IPN fill:#EF5350,color:#fff
    style DONE fill:#26A69A,color:#fff
    style P fill:#FFF9C4
    style PR fill:#C8E6C9
    style SH fill:#BBDEFB
    style D fill:#A5D6A7
    style X fill:#FFCDD2
